{
  "name": "@campushub/backend",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/with-node-env.mjs development tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "node ../scripts/with-node-env.mjs test vitest run tests/unit",
    "test:db": "node ../scripts/with-node-env.mjs test vitest run tests/db",
    "test:integration": "node ../scripts/with-node-env.mjs test vitest run tests/integration tests/concurrency",
    "create-super-admin": "tsx src/scripts/create-super-admin.ts",
    "seed:dev": "node ../scripts/with-node-env.mjs development tsx src/scripts/seed-dev.ts",
    "seed:if-empty": "node ../scripts/with-node-env.mjs development tsx src/scripts/seed-dev.ts --if-empty",
    "auth:check": "npx @better-auth/cli generate --config src/lib/auth.ts",
    "storage:sweep": "node ../scripts/with-node-env.mjs development tsx src/scripts/storage-sweep.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@campushub/shared": "*",
    "ably": "^2.14.0",
    "better-auth": "^1.7.18",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.0",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
