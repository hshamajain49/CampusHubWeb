# backend/.env.example — copy to backend/.env
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
TRUST_PROXY=0
# Local cluster by default. For Neon, run `npm run neon:env`: it appends a managed block that points DATABASE_URL at the
# branch's DIRECT endpoint (the API's startup options don't work through the -pooler endpoint) and sets IMAGE_STORE=neon.
DATABASE_URL=postgresql://campushub:campushub@localhost:5432/campushub?sslmode=disable
DATABASE_SSL=false
DATABASE_POOL_MAX=5
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:4000
EMAIL_TRANSPORT=console
EMAIL_FROM_NAME=CampusHub
EMAIL_OUTBOX_DIR=.tmp/outbox
# Optional integrations (leave empty to disable)
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
ABLY_API_KEY=
# Venue photos: neon (Neon Object Storage), cloudinary, or fake (local disk; refused in production)
IMAGE_STORE=fake
NEON_STORAGE_BUCKET=venue-photos
# Complaint photos: private bucket, presigned URLs. Defaults to neon unless IMAGE_STORE=fake (then local disk).
# COMPLAINT_PHOTO_STORE=neon
NEON_COMPLAINT_BUCKET=complaint-photos
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDINARY_URL=
CLOUDINARY_FOLDER=campushub-dev/venues
CRON_SECRET=replace-with-32-plus-random-characters
