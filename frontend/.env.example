# frontend/.env.example — copy to frontend/.env.local
VITE_API_ORIGIN=http://localhost:4000
VITE_APP_NAME=CampusHub

# Visitor analytics (CampusHub Sentinel). Leave empty to switch it off completely.
# Both values are public: the site key only lets a browser add page views for the allowed origins.
# The site key comes from Sentinel's `npm run app:register` (it is not a secret).
VITE_SENTINEL_URL=
VITE_SENTINEL_SITE_KEY=
# Link page views to the signed-in account (off by default; see the Privacy page wording before switching on).
VITE_SENTINEL_LINK_USERS=false
